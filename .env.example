VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ── WebRTC TURN relay (voice & video calls) ──────────────────────────────
# Optional, but calls WILL fail without it between peers behind symmetric NAT
# — which is what most mobile carrier networks use. The symptom is a call that
# rings and "connects" but has no audio or video in either direction.
# STUN (already built in) cannot traverse those networks; only a TURN relay can.
#
# Get credentials from a TURN provider (Twilio, Metered, Cloudflare Calls) or
# self-host coturn. Multiple URLs may be comma-separated.
# Example: turn:relay.example.com:3478,turns:relay.example.com:5349
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
