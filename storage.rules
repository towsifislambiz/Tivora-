rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ─── User Profile, Cover, and Posts Storage ───────────────────────────────
    // Users may only write to their own UID-scoped paths.
    // Files must be images only. Max 10MB per file.
    match /users/{userId}/{allPaths=**} {
      // Any authenticated user may read public profile/post images
      allow read: if true;

      // Only the owning authenticated user may write to their own path
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // ─── Group Cover Photos Storage ──────────────────────────────────────────
    // Group admins/owners write group images. Anyone can read.
    match /groups/{groupId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
